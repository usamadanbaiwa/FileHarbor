# Local review settings. Use HTTPS and FILEHARBOR_ENV=production on deployment.
FILEHARBOR_ENV=development
FILEHARBOR_URL=http://127.0.0.1:7241

HOST=127.0.0.1
PORT=7241

# Replace with a random secret before starting. No usable default is supplied.
FILEHARBOR_SETUP_TOKEN=

# Separate directories, on the same filesystem; state must remain private.
STORAGE_PATH=./storage
FILEHARBOR_STATE_PATH=./var

SERVE_FILES=true
PUBLIC_CACHE_MAX_AGE=86400

MAX_FILE_SIZE_MB=25

MAX_CONCURRENT_UPLOADS=4

ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,video/mp4
MIME_TYPE_EXTENSIONS={}

API_RATE_LIMIT=100

API_RATE_WINDOW_SECONDS=60
